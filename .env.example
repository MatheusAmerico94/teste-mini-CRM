# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_publishable_key_here
CLERK_SECRET_KEY=your_secret_key_here
CLERK_WEBHOOK_SECRET=your_webhook_secret_here
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Supabase PostgreSQL (prefira a URL do pooler para Vercel e Render)
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Aplicação
NEXT_PUBLIC_URL=http://localhost:3000
APP_ENCRYPTION_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Serviço Baileys (use o mesmo token no Vercel e Render)
WHATSAPP_SERVICE_URL=http://localhost:3001
WHATSAPP_SERVICE_TOKEN=replace-with-another-long-random-secret
CRM_OWNER_EMAIL=you@example.com
WHATSAPP_SESSION_DIR=./whatsapp-session
PORT=3001

# Fallback opcional; a chave pode ser cadastrada criptografada no painel
OPENAI_API_KEY=
