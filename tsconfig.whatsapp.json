{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "outDir": "./dist",
        "rootDir": "./",
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./*"
            ]
        }
    },
    "include": [
        "whatsapp-service/**/*",
        "lib/**/*",
        "lib/db/**/*",
        "lib/services/**/*"
    ],
    "exclude": [
        "node_modules",
        "app/**/*",
        "components/**/*",
        "public/**/*",
        "**/*.test.ts"
    ]
}